<script>
"use strict";
const $=id=>document.getElementById(id);
const DBKEY="secure_qr_vault_v1";
const SESSIONKEY="secure_qr_session_v1";
let db=null,currentUser=null;
let photoImages=[],posterImage=null,photoStickers=[],posterStickers=[];
let scanStream=null,scanLoop=null;
let lastDesignData=null,lastPosterData=null;

function freshDB(){
 return {users:{},activeUser:null};
}
function loadDB(){
 try{return JSON.parse(localStorage.getItem(DBKEY))||freshDB()}
 catch(e){return freshDB()}
}
function saveDB(){
 try{localStorage.setItem(DBKEY,JSON.stringify(db));return true}
 catch(e){alert("Storage भर गया है। कुछ पुरानी फोटो या फाइलें हटाएँ या Backup लें।");return false}
}
function userData(){
 return db.users[currentUser];
}
function saveUser(){
 if(currentUser&&db.users[currentUser])saveDB();
}
function esc(s){
 return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function login(){
 const name=$("loginName").value.trim();
 const pass=$("loginPass").value;
 if(!name||!pass){$("loginStatus").textContent="Name और Password दोनों लिखें।";return}
 db=loadDB();
 let key=name.toLowerCase();
 if(!db.users[key]){
  db.users[key]={name:name,password:pass,coins:20000,lastReward:new Date().toDateString(),
   photos:[],posters:[],identities:[],gifts:[],messages:[]};
 }else if(db.users[key].password!==pass){
  $("loginStatus").textContent="Password सही नहीं है।";
  return;
 }
 currentUser=key;
 if(!Array.isArray(userData().photos))userData().photos=[];
 if(!Array.isArray(userData().posters))userData().posters=[];
 if(!Array.isArray(userData().identities))userData().identities=[];
 if(!Array.isArray(userData().gifts))userData().gifts=[];
 if(!Array.isArray(userData().messages))userData().messages=[];
 if(!Number.isFinite(userData().coins))userData().coins=20000;
 const today=new Date().toDateString();
 if(userData().lastReward!==today){
  userData().coins+=20000;userData().lastReward=today;
 }
 db.activeUser=key;saveDB();
 localStorage.setItem(SESSIONKEY,key);
 $("loginScreen").classList.add("hidden");
 $("app").classList.remove("hidden");
 $("accountBar").classList.remove("hidden");
 updateCoins();initEditors();applyGiftTheme();identityFields();
}
function logout(){
 localStorage.removeItem(SESSIONKEY);
 db=loadDB();db.activeUser=null;saveDB();
 currentUser=null;
 $("app").classList.add("hidden");$("accountBar").classList.add("hidden");
 $("loginScreen").classList.remove("hidden");
 $("loginPass").value="";
}
function updateCoins(){
 if(!currentUser)return;
 $("coinCount").textContent=userData().coins;
 $("homeCoins").textContent=userData().coins;
 $("welcome").textContent="Hello, "+userData().name;
}
function spendCoins(n){
 if(userData().coins<n){alert("Coins कम हैं। आपके पास "+userData().coins+" Coins हैं।");return false}
 userData().coins-=n;saveUser();updateCoins();return true;
}
function showTab(id,btn){
 document.querySelectorAll(".tab").forEach(x=>x.classList.add("hidden"));
 $(id).classList.remove("hidden");
 document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));
 if(btn)btn.classList.add("active");
 if(id==="photo")redrawEditor();
 if(id==="poster")redrawEditor();
}
function newId(){return Date.now().toString(36)+"-"+Math.random().toString(36).slice(2,8)}
function stamp(){return new Date().toLocaleString()}
function makeQR(text,target){
 const el=$(target);el.innerHTML="";
 const holder=document.createElement("div");holder.id="qrOutput";
 el.appendChild(holder);
 if(!window.QRCode){
  el.innerHTML="<p>QR library load नहीं हुई। इंटरनेट कनेक्शन जाँचें।</p>";
  const t=document.createElement("textarea");t.value=text;el.appendChild(t);return;
 }
 try{
  new QRCode(holder,{text:String(text),width:230,height:230,
   colorDark:"#000000",colorLight:"#ffffff",correctLevel:QRCode.CorrectLevel.L});
  const ta=document.createElement("textarea");ta.value=text;ta.readOnly=true;
  ta.style.marginTop="10px";el.appendChild(ta);
  const b=document.createElement("button");b.textContent="Copy QR Payload";
  b.onclick=()=>copyText(text);el.appendChild(b);
 }catch(e){
