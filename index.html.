function drawCover(ctx,img,x,y,w,h){
 const scale=Math.max(w/img.width,h/img.height);
 const sw=w/scale,sh=h/scale;
 ctx.drawImage(img,(img.width-sw)/2,(img.height-sh)/2,sw,sh,x,y,w,h);
}
function wrapText(ctx,text,maxWidth){
 const words=String(text||"").split(/\s+/);let lines=[],line="";
 words.forEach(word=>{
  const test=line?line+" "+word:word;
  if(ctx.measureText(test).width>maxWidth&&line){lines.push(line);line=word}
  else line=test;
 });
 if(line)lines.push(line);
 return lines;
}
function drawBackground(ctx,w,h,color){
 ctx.fillStyle=color||"#152746";ctx.fillRect(0,0,w,h);
 const g=ctx.createRadialGradient(w*.5,h*.25,10,w*.5,h*.5,w*.8);
 g.addColorStop(0,"#ffffff12");g.addColorStop(1,"#00000033");
 ctx.fillStyle=g;ctx.fillRect(0,0,w,h);
}
