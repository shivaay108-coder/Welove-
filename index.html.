function importBackup(){
 const f=$("backupFile").files[0];if(!f){alert("पहले JSON backup चुनें।");return}
 const r=new FileReader();
 r.onload=()=>{
  try{
   const d=JSON.parse(r.result);
   const u=d.user||d;
   if(!u||typeof u!=="object")throw Error("Invalid backup");
   ["photos","posters","identities","gifts","messages"].forEach(k=>{if(!Array.isArray(u[k]))u[k]=[]});
   if(confirm("Current collections replace करके backup restore करें?")){
    const key=currentUser;u.name=userData().name;u.password=userData().password;
    db.users[key]=u;saveDB();updateCoins();
    $("settingsStatus").textContent="Backup restored.";
   }
  }catch(e){$("settingsStatus").textContent="Backup error: "+e.message}
 };
 r.readAsText(f);
}
function clearCollections(){
 if(!confirm("सभी Photo, Poster, QR Identity, Gift और Message collections delete करें?"))return;
 ["photos","posters","identities","gifts","messages"].forEach(k=>userData()[k]=[]);
 saveUser();$("filesList").innerHTML="";$("settingsStatus").textContent="Collections deleted.";
}
