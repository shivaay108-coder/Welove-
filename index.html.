
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Secure QR Vault</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{
 --bg:#07111f;--panel:#101f32;--panel2:#162941;
 --cyan:#35e6ff;--blue:#388bff;--purple:#bd77ff;
 --green:#4dffb5;--gold:#ffd166;--text:#f1f7ff;--muted:#a6bad1;
 --danger:#ff6584;
}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at top,#12294b,#07111f 55%);
 color:var(--text);font-family:Arial,sans-serif}
header{padding:16px;text-align:center;background:#0a1628;
 border-bottom:1px solid #24415e;position:sticky;top:0;z-index:5}
header h1{margin:0;color:var(--cyan);font-size:24px}
header p{margin:6px 0 0;color:var(--muted);font-size:12px}
#accountBar{display:flex;justify-content:center;gap:10px;align-items:center;
 flex-wrap:wrap;margin-top:10px;font-size:13px}
.coin{color:var(--gold);font-weight:bold}
nav{display:flex;gap:7px;overflow-x:auto;padding:10px;background:#091525;
 position:sticky;top:92px;z-index:4}
nav button{white-space:nowrap;flex-shrink:0}
button,.btn{
 background:linear-gradient(135deg,#167caa,#3457bd);color:white;border:0;
 border-radius:10px;padding:11px 14px;font-weight:bold;cursor:pointer;
 margin:3px;transition:.15s
}
button:active{transform:scale(.97)}
button.secondary{background:#263a52}
button.green{background:#087b60}
button.gold{background:#8c6410}
button.red{background:#a52e4d}
button.active{outline:2px solid var(--cyan)}
main{max-width:1050px;margin:auto;padding:14px}
.panel{background:linear-gradient(145deg,#102138,#0c192b);
 border:1px solid #24425f;border-radius:17px;padding:16px;margin-bottom:14px;
 box-shadow:0 8px 25px #0003}
h2{font-size:21px;color:var(--cyan);margin:0 0 14px}
h3{font-size:16px;color:var(--gold)}
p,.hint{line-height:1.5;color:var(--muted);font-size:13px}
label{display:block;color:#c8d9ed;font-size:13px;margin:10px 0 5px}
input,textarea,select{width:100%;padding:12px;border-radius:9px;
 border:1px solid #34516f;background:#071525;color:white;outline:none}
textarea{min-height:85px;resize:vertical}
input:focus,textarea:focus,select:focus{border-color:var(--cyan)}
.row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px}
.tool{background:#12243a;border:1px solid #29435f;padding:13px;border-radius:12px}
.hidden{display:none!important}
.status{padding:10px;border-radius:9px;background:#071525;color:var(--green);
 margin-top:10px;white-space:pre-wrap;overflow-wrap:anywhere}
#qrOutput{background:white;padding:12px;border-radius:10px;display:table;
 margin:12px auto;min-height:10px}
#qrOutput img,#qrOutput canvas{max-width:100%;height:auto}
#editorCanvas{width:100%;max-height:480px;object-fit:contain;
 background:#07111f;border:1px solid #35506e;border-radius:12px;touch-action:manipulation}
.preview{background:#071525;border-radius:12px;padding:10px;text-align:center}
.file{padding:12px;border:1px solid #29445f;border-radius:10px;margin:8px 0;
 background:#0a192b;overflow-wrap:anywhere}
.file strong{color:var(--cyan)}
.file small{color:var(--muted)}
.file button{padding:8px 10px;font-size:12px}
#loginScreen{max-width:430px;margin:35px auto;padding:18px}
#loginScreen h2{text-align:center}
.emojiRow{display:flex;gap:5px;flex-wrap:wrap}
.emojiRow button{font-size:21px;padding:8px;background:#203751}
footer{text-align:center;color:#6f89a5;padding:20px;font-size:12px}
@media(max-width:600px){
 header h1{font-size:20px}
 nav{top:104px}
 .row{grid-template-columns:1fr}
 main{padding:9px}
 .panel{padding:12px}
}
</style>
</head>
