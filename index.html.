 else if(photoImages.length>1){
  const cols=2,rows=Math.ceil(photoImages.length/2),cw=w/cols,ch=h/rows;
  photoImages.forEach((im,i)=>drawCover(ctx,im,(i%cols)*cw,Math.floor(i/cols)*ch,cw,ch));
 }else{
  ctx.fillStyle="#ffffff22";ctx.fillRect(30,30,w-60,h-60);
